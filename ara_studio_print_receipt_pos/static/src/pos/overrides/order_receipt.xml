<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ara_studio_print_receipt_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')][1]" position="attributes">
            <attribute name="t-if">!hasCustomReceipt()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')][1]" position="after">
            <div t-if="hasCustomReceipt()" class="pos-receipt ara-pos-receipt-wrapper p-2">
                <AraCustomReceipt data="props.data" order="pos?.get_order()" template="customTemplate" formatCurrency="props.formatCurrency"/>
            </div>
        </xpath>
    </t>

</templates>
